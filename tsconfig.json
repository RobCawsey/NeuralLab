{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/__tests__/**/*.ts",
    "apps/web/src/**/*.ts",
    "apps/web/*.ts",
    "scripts/**/*.ts",
    "*.config.ts"
  ]
}
